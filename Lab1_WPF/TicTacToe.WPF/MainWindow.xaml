<Window x:Class="TicTacToe.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicTacToe.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="350">
    <Grid Height="390" Width="300" VerticalAlignment="Bottom">
        <Grid Width="300" Height="300" Margin="0,0,0,-50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <Button x:Name="Button_0" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="0" Grid.Column="0"/>
            <Button x:Name="Button_1" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="0" Grid.Column="1"/>
            <Button x:Name="Button_2" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="0" Grid.Column="2"/>
            <Button x:Name="Button_3" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="1" Grid.Column="0"/>
            <Button x:Name="Button_4" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="1" Grid.Column="1"/>
            <Button x:Name="Button_5" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="1" Grid.Column="2"/>
            <Button x:Name="Button_6" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="2" Grid.Column="0"/>
            <Button x:Name="Button_7" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="2" Grid.Column="1"/>
            <Button x:Name="Button_8" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="72" FontFamily="Yu Gothic UI Semilight" Click="ButtonClick" Grid.Row="2" Grid.Column="2"/>
        </Grid>
        <TextBox x:Name="textBox" HorizontalAlignment="Center" Margin="0,40,-20,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" BorderBrush="{x:Null}" FontSize="18"/>

    </Grid>
</Window>
